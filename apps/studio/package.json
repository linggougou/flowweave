{
  "name": "@flowweave/app-studio",
  "version": "1.0.0",
  "description": "面向本地网页自动化的织流桌面工作台",
  "author": "linggougou",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "ensure:electron-dist": "node ./scripts/ensure-electron-dist.mjs",
    "ensure:electron-native-binding": "node ./scripts/ensure-electron-native-binding.mjs",
    "postinstall": "node ./scripts/ensure-electron-dist.mjs",
    "build:electron": "node ./scripts/build-electron.mjs && node ./scripts/ensure-electron-native-binding.mjs",
    "build": "node ./scripts/ensure-electron-dist.mjs && pnpm build:electron && vite build",
    "package:dir": "pnpm build && playwright install chromium && electron-builder --config electron-builder.config.cjs --mac --dir",
    "package:mac": "pnpm build && playwright install chromium && electron-builder --config electron-builder.config.cjs --mac dmg",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint src electron",
    "test": "vitest run --passWithNoTests",
    "dev": "node ./scripts/ensure-electron-dist.mjs && pnpm build:electron && concurrently -k \"node ./scripts/watch-electron.mjs\" \"vite\" \"wait-on http://127.0.0.1:5173 && node ./scripts/dev-electron.mjs\""
  },
  "dependencies": {
    "@flowweave/flow-dsl": "workspace:*",
    "@flowweave/project-knowledge": "workspace:*",
    "@flowweave/page-intelligence": "workspace:*",
    "@flowweave/runtime": "workspace:*",
    "@flowweave/shared": "workspace:*",
    "@flowweave/ui": "workspace:*",
    "better-sqlite3": "12.1.1",
    "drizzle-orm": "^0.38.3",
    "playwright": "^1.49.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
