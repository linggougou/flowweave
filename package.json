{
  "name": "flowweave",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "doctor": "node scripts/doctor.mjs",
    "smoke:prepare": "node scripts/doctor.mjs --smoke",
    "smoke": "pnpm smoke:prepare && pnpm typecheck && pnpm test && pnpm build && sh -c 'test \"$SKIP_E2E\" = 1 || pnpm e2e:login'",
    "smoke:full": "pnpm smoke:prepare && pnpm typecheck && pnpm test && pnpm build && pnpm e2e:login && pnpm e2e:real-pages",
    "e2e:login": "tsx examples/run-login-flow.ts",
    "e2e:real-pages": "tsx examples/run-real-page-smoke.ts",
    "e2e:recorded-pages": "tsx examples/recorded-replay-smoke.ts",
    "dev:web": "pnpm --filter @flowweave/app-web dev",
    "dev:studio": "pnpm --filter @flowweave/app-studio dev",
    "dev:extension": "pnpm --filter @flowweave/app-extension dev"
  },
  "dependencies": {
    "@flowweave/flow-dsl": "workspace:*",
    "@flowweave/project-knowledge": "workspace:*",
    "@flowweave/runtime": "workspace:*",
    "@flowweave/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
