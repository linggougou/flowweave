{
  "name": "flowweave",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "e2e:login": "tsx examples/run-login-flow.ts",
    "dev:web": "pnpm --filter @flowweave/app-web dev"
  },
  "dependencies": {
    "@flowweave/flow-dsl": "workspace:*",
    "@flowweave/project-knowledge": "workspace:*",
    "@flowweave/runtime": "workspace:*",
    "@flowweave/shared": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
